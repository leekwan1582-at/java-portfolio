classDiagram
    direction TB

    class TradingStrategy {
        <<abstract>>
        #String strategyName
        +TradingStrategy(String name)
        +getName() String
        +executeTrade(HistoricalData data)* Trade
        +reset() void
    }

    class MovingAverageStrategy {
        -int period
        -Queue~Double~ priceWindow
        +MovingAverageStrategy(int period)
        +executeTrade(HistoricalData data) Trade
        +reset() void
    }

    class RSIStrategy {
        -int period
        -Queue~Double~ priceWindow
        -double previousClose
        +RSIStrategy(int period)
        +executeTrade(HistoricalData data) Trade
        +reset() void
    }

    class MACDStrategy {
        -List~Double~ priceHistory
        -double fastEMA
        -double slowEMA
        -double signalEMA
        -double kFast
        -double kSlow
        -double kSignal
        -boolean isInitialized
        +MACDStrategy()
        +executeTrade(HistoricalData data) Trade
        -calculateInitialSMA(List~Double~ list, int period) double
        +reset() void
    }

    class BacktestEngine {
        -TradingStrategy strategy
        -String dataCsv
        -String startDate
        -String endDate
        +BacktestEngine(TradingStrategy strategy, String dataCsv, String startDate, String endDate)
        +BacktestEngine(TradingStrategy strategy, String startDate, String endDate)
        +getStrategy() TradingStrategy
        +setStrategy(TradingStrategy strategy) void
        +getDataCsv() String
        +setDataCsv(String dataCsv) void
        +getStartDate() String
        +setStartDate(String startDate) void
        +getEndDate() String
        +setEndDate(String endDate) void
        +toString() String
        +runBacktest() void
        +runSingleTest(TradingStrategy strategy, String csvPath, String start, String end)$ void
        +main(String[] args)$ void
    }

    class Trade {
        -String ticker
        -double executionPrice
        -boolean isBuy
        +Trade(String ticker, double executionPrice, boolean isBuy)
        +printTradeDetails() void
    }

    class HistoricalData {
        -String date
        -double closePrice
        +HistoricalData(String date, double closePrice)
        +getDate() String
        +getClosePrice() double
    }

    %% Inheritance Relationships (Generalization)
    MovingAverageStrategy --|> TradingStrategy : extends
    RSIStrategy --|> TradingStrategy : extends
    MACDStrategy --|> TradingStrategy : extends
    
    %% Association / Composition
    BacktestEngine ..> TradingStrategy
    
    %% Dependencies
    MovingAverageStrategy ..> HistoricalData
    MovingAverageStrategy ..> Trade
    RSIStrategy ..> HistoricalData
    RSIStrategy ..> Trade
    MACDStrategy ..> HistoricalData
    MACDStrategy ..> Trade
    BacktestEngine ..> HistoricalData
    BacktestEngine ..> Trade